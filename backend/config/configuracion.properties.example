# Copia este archivo como configuracion.properties y pon tus datos.
# configuracion.properties NO se sube a git (tiene la contraseña de la base).

# --- Base de datos MySQL ---
# MySQL corre en la máquina de AWS y el backend en Windows: va la IP pública de la
# máquina. La conexión viaja cifrada; el usuario app_web la exige (REQUIRE SSL).
bd.url=jdbc:mysql://IP_DE_LA_MAQUINA:3306/magic_cards?sslMode=REQUIRED&characterEncoding=UTF-8
bd.usuario=app_web
bd.contrasena=cambiar

# --- Servidor HTTP ---
servidor.puerto=8080

# --- Sesiones: horas que dura un inicio de sesión ---
sesion.horas=8

# --- Reservas: días de plazo para reclamar (sección H del documento de supuestos) ---
reserva.dias=30

# --- Fecha de "hoy" de la tienda, sin importar la zona horaria del equipo ---
zona.horaria=America/Bogota

# --- Orígenes permitidos (CORS), separados por coma: donde corre Angular ---
cors.origen=http://localhost:4200
