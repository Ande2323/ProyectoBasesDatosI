# Servicio de Linux para que el backend arranque solo con la máquina.
# Instalación: ver "Subirlo a la máquina de AWS" en README.md
[Unit]
Description=Backend Magic Cards
After=network.target mysql.service

[Service]
# Ajuste el usuario y la ruta a los de su máquina.
User=ubuntu
WorkingDirectory=/home/ubuntu/ProyectoBasesDatosI/backend
ExecStart=/home/ubuntu/ProyectoBasesDatosI/backend/ejecutar.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
